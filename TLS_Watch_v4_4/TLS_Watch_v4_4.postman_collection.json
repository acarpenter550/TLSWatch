    {
      "name": "Local dashboard administration — optional",
      "description": "WARNING: these are admin routes, not read-only API routes. They are accessible only on localhost without app credentials. When APP_USERNAME/PASSWORD is configured, set adminUsername/adminPassword for Basic auth; also secure with HTTPS/proxy when remote. The API key does not authorize these.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{adminUsername}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{adminPassword}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "View settings and recent deliveries",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/settings",
            "description": "Dashboard administration: API key status (never the key), webhook subscriptions, recent delivery status."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate or rotate API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/settings/api-key",
            "description": "DANGER: immediately revokes a prior API key. Response contains a NEW key shown ONCE. Copy to the apiKey collection variable manually. Only run intentionally.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Generated a key\", function () {pm.response.to.have.status(200); pm.expect(pm.response.json().api_key).to.match(/^tlsw_/);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke API key (destructive)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/settings/api-key",
            "description": "DANGER: destroys the current remote API key. Do not invoke except to disable remote API access."
          },
          "response": []
        },
        {
          "name": "Save webhook (disabled setup)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/settings/webhook",
            "description": "Sets URL and event selections while delivery is disabled, allowing you to copy a generated signing secret safely. Set webhookUrl first. On initial save, response contains a signing_secret shown ONCE. Changing URL or disabling cancels pending deliveries.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false,\n  \"url\": \"{{webhookUrl}}\",\n  \"events\": [\n    \"expiration_90\",\n    \"expiration_60\",\n    \"expiration_30\",\n    \"certificate_expired\",\n    \"tls_invalid\",\n    \"check_failed\",\n    \"recovered\",\n    \"certificate_changed\",\n    \"needs_attention\",\n    \"attention_cleared\"\n  ],\n  \"allow_http\": false,\n  \"allow_private\": false,\n  \"allow_self_signed\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Enable webhook",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/settings/webhook",
            "description": "After configuring your HTTPS receiver and copying the signing secret, enable delivery using this saved event selection.",
            "body": {
              "mode": "raw",
