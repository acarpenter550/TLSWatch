{
  "info": {
    "name": "TLS Watch v4.4 — Distributed Agent Monitoring, Groups, APIs & Webhooks",
    "description": "Read-only certificate and history GET endpoints use X-API-Key. Admin routes for import/backup and independent webhooks require local/dashboard credentials. See api.md. Never share real credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Read-only monitoring API — X-API-Key",
      "description": "The preferred integration/API. Works remotely over HTTPS after you expose TLS Watch securely; requires an API key. GET only.",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "X-API-Key",
            "type": "string"
          },
          {
            "key": "value",
            "value": "{{apiKey}}",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      },
